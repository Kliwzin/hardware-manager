<ui:FluentWindow x:Class="HardwareManager.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:HardwareManager.App.Pages"
                 Title="Hardware Manager"
                 Width="1100" Height="720" MinWidth="800" MinHeight="500"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Hardware Manager" />

        <ui:InfoBar Grid.Row="1" Margin="12,0,12,8"
                    Title="{Binding WarningTitle}"
                    Message="{Binding WarningMessage}"
                    Severity="{Binding WarningSeverity}"
                    IsOpen="{Binding ShowWarning, Mode=TwoWay}"
                    IsClosable="True" />

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="2"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="200">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Visão geral"
                                       TargetPageType="{x:Type pages:OverviewPage}"
                                       Icon="{ui:SymbolIcon Home24}" />
                <ui:NavigationViewItem Content="Sensores"
                                       TargetPageType="{x:Type pages:SensorsPage}"
                                       Icon="{ui:SymbolIcon Table24}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <ui:ProgressRing Grid.Row="2" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</ui:FluentWindow>