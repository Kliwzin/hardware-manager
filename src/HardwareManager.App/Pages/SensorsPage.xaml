<Page x:Class="HardwareManager.App.Pages.SensorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sensores"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,8" Opacity="0.7" TextWrapping="Wrap"
                   Text="Marque &quot;Oculto&quot; para tirar um sensor da visão geral. O nome personalizado substitui o original." />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Componente" Binding="{Binding ComponentName}" IsReadOnly="True" Width="200" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Sensor.Kind}" IsReadOnly="True" Width="110" />
                <DataGridTextColumn Header="Sensor" Binding="{Binding Sensor.Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Nome personalizado" Binding="{Binding CustomName}" Width="180" />
                <DataGridTextColumn Header="Valor" Binding="{Binding Text}" IsReadOnly="True" Width="110" />
                <DataGridTemplateColumn Header="Oculto" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding IsHidden, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>